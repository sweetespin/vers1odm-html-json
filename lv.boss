-- ============================================================
-- LOGGER
-- ============================================================
local Logger = {}
Logger.__index = Logger
function Logger.new(prefix) return setmetatable({ prefix = prefix, buffer = {}, muted = false }, Logger) end
function Logger:write(level, message)
    local stamp = string.format("%02d:%02d:%02d",
        math.floor((os.clock() - State.sessionStart) / 3600) % 24,
        math.floor((os.clock() - State.sessionStart) / 60) % 60,
        math.floor(os.clock() - State.sessionStart) % 60)
    local line = string.format("%s [%s] [%s] %s", self.prefix, stamp, level, message)
    table.insert(self.buffer, line)
    if #self.buffer > CONFIG.maxLogEntries then table.remove(self.buffer, 1) end
    if not self.muted then print(line) end
    return line
end
function Logger:info(m) return self:write("INFO", m) end
function Logger:warn(m) State.metrics.warnings = State.metrics.warnings + 1 return self:write("WARN", m) end
function Logger:err(m) State.metrics.errors = State.metrics.errors + 1 return self:write("ERR ", m) end
function Logger:mute() self.muted = true end
function Logger:unmute() self.muted = false end
function Logger:flush() self.buffer = {} end
function Logger:dump(n)
    local out = {}
    local start = math.max(1, #self.buffer - (n or #self.buffer) + 1)
    for i = start, #self.buffer do table.insert(out, self.buffer[i]) end
    return table.concat(out, "\n")
end
local log = Logger.new("[ADOPT TRADE]")

-- ============================================================
-- MATH EXTENSIONS
-- ============================================================
local MathX = {}
function MathX.clamp(v, lo, hi) if v < lo then return lo end if v > hi then return hi end return v end
function MathX.lerp(a, b, t) return a + (b - a) * MathX.clamp(t, 0, 1) end
function MathX.round(v, p) local m = 10 ^ (p or 0) return math.floor(v * m + 0.5) / m end
function MathX.sign(v) if v > 0 then return 1 end if v < 0 then return -1 end return 0 end
function MathX.approx(a, b, e) return math.abs(a - b) <= (e or 1e-6) end
function MathX.percent(v, t) if t == 0 then return 0 end return (v / t) * 100 end

-- ============================================================
-- STRING UTILITIES
-- ============================================================
local StrX = {}
function StrX.trim(s) return (s:gsub("^%s+", ""):gsub("%s+$", "")) end
function StrX.startsWith(s, p) return s:sub(1, #p) == p end
function StrX.endsWith(s, p) return s:sub(-#p) == p end
function StrX.split(s, sep) local out = {} for part in s:gmatch(string.format("([^%s]+)", sep or "%s")) do table.insert(out, part) end return out end
function StrX.join(t, sep) return table.concat(t, sep or "") end
function StrX.capitalize(s) return (s:gsub("^%l", string.upper)) end
function StrX.truncate(s, n) if #s <= n then return s end return s:sub(1, n - 3) .. "..." end
function StrX.formatNumber(n)
    if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
    if n >= 1e6 then return string.format("%.2fM", n / 1e6) end
    if n >= 1e3 then return string.format("%.2fK", n / 1e3) end
    return tostring(n)
end
function StrX.formatTime(s)
    s = math.floor(s)
    local m = math.floor(s / 60)
    local h = math.floor(m / 60)
    if h > 0 then return string.format("%dh %dm %ds", h, m % 60, s % 60) end
    if m > 0 then return string.format("%dm %ds", m, s % 60) end
    return string.format("%ds", s)
end

-- ============================================================
-- TABLE UTILITIES
-- ============================================================
local TableX = {}
function TableX.copy(t) return { table.unpack(t) } end
function TableX.deepcopy(v, seen)
    if type(v) ~= "table" then return v end
    seen = seen or {}
    if seen[v] then return seen[v] end
    local c = {} seen[v] = c
    for k, val in next, v do c[TableX.deepcopy(k, seen)] = TableX.deepcopy(val, seen) end
    return c
end
function TableX.keys(t) local o = {} for k in next, t do table.insert(o, k) end return o end
function TableX.values(t) local o = {} for _, v in next, t do table.insert(o, v) end return o end
function TableX.contains(t, v) for _, x in next, t do if x == v then return true end end return false end
function TableX.indexOf(t, v) for i, x in ipairs(t) do if x == v then return i end end end
function TableX.filter(t, f) local o = {} for i, v in ipairs(t) do if f(v, i) then table.insert(o, v) end end return o end
function TableX.map(t, f) local o = {} for i, v in ipairs(t) do o[i] = f(v, i) end return o end
function TableX.reduce(t, f, init) local a = init for _, v in ipairs(t) do a = f(a, v) end return a end
function TableX.count(t, f) local n = 0 for _, v in ipairs(t) do if f(v) then n = n + 1 end end return n end
function TableX.sortBy(t, f) table.sort(t, function(a, b) return f(a) < f(b) end) return t end

-- ============================================================
-- SIGNAL
-- ============================================================
local Signal = {}
Signal.__index = Signal
function Signal.new() return setmetatable({ handlers = {} }, Signal) end
function Signal:connect(fn)
    if type(fn) ~= "function" then error("Signal:connect expects function", 2) end
    local id = HttpService:GenerateGUID(false)
    self.handlers[id] = fn
    return { disconnect = function() self.handlers[id] = nil end, id = id }
end
function Signal:fire(...)
    local args = { ... }
    for _, fn in pairs(self.handlers) do
        local ok, err = pcall(fn, table.unpack(args))
        if not ok then log:err("Signal handler: " .. tostring(err)) end
    end
end
function Signal:clear() self.handlers = {} end
function Signal:count() local n = 0 for _ in pairs(self.handlers) do n = n + 1 end return n end

-- ============================================================
-- EVENT BUS
-- ============================================================
local EventBus = {}
EventBus.__index = EventBus
function EventBus.new() return setmetatable({ channels = {} }, EventBus) end
function EventBus:channel(name)
    if not self.channels[name] then self.channels[name] = Signal.new() end
    return self.channels[name]
end
function EventBus:on(name, fn) return self:channel(name):connect(fn) end
function EventBus:emit(name, ...) self:channel(name):fire(...) end
local bus = EventBus.new()

-- ============================================================
-- STORE
-- ============================================================
local Store = {}
Store.__index = Store
function Store.new(init) return setmetatable({ data = init or {}, listeners = Signal.new() }, Store) end
function Store:get(k) return self.data[k] end
function Store:set(k, v) local p = self.data[k] self.data[k] = v self.listeners:fire(k, v, p) return v end
function Store:update(k, f) return self:set(k, f(self.data[k])) end
local store = Store.new({
    status = "idle",
    suggestionCount = 0,
    mockCount = 0,
    acceptCount = 0,
    fps = 0,
})

-- ============================================================
-- SCHEDULER
-- ============================================================
local Scheduler = {}
Scheduler.__index = Scheduler
function Scheduler.new() return setmetatable({ tasks = {}, nextId = 0, running = false }, Scheduler) end
function Scheduler:every(i, f) self.nextId = self.nextId + 1 self.tasks[self.nextId] = { interval = i, fn = f, last = os.clock() } return self.nextId end
function Scheduler:cancel(id) self.tasks[id] = nil end
function Scheduler:tick()
    if not self.running then return end
    local now = os.clock()
    for id, task_ in pairs(self.tasks) do
        if now - task_.last >= task_.interval then
            task_.last = now
            local ok, err = pcall(task_.fn)
            if not ok then log:err("Scheduler task " .. tostring(id) .. ": " .. tostring(err)) end
        end
    end
end
function Scheduler:start() self.running = true end
function Scheduler:stop() self.running = false end
local scheduler = Scheduler.new()

-- ============================================================
-- RATE LIMITER
-- ============================================================
local RateLimiter = {}
RateLimiter.__index = RateLimiter
function RateLimiter.new(r, b)
    local self = setmetatable({}, RateLimiter)
    self.rate = r or 5
    self.burst = b or r or 5
    self.tokens = self.burst
    self.last = os.clock()
    return self
end
function RateLimiter:allow()
    local now = os.clock()
    self.tokens = math.min(self.burst, self.tokens + (now - self.last) * self.rate)
    self.last = now
    if self.tokens >= 1 then self.tokens = self.tokens - 1 return true end
    return false
end

-- ============================================================
-- CACHE
-- ============================================================
local Cache = {}
Cache.__index = Cache
function Cache.new(ttl) return setmetatable({ ttl = ttl or 30, entries = {} }, Cache) end
function Cache:set(k, v) self.entries[k] = { value = v, expires = os.clock() + self.ttl } return v end
function Cache:get(k)
    local e = self.entries[k]
    if not e then return nil end
    if os.clock() > e.expires then self.entries[k] = nil return nil end
    return e.value
end
function Cache:purge()
    local now = os.clock()
    for k, e in pairs(self.entries) do if now > e.expires then self.entries[k] = nil end end
end

-- ============================================================
-- BACKPACK
-- ============================================================
local Backpack = {}
Backpack.__index = Backpack
function Backpack.new(player)
    return setmetatable({ player = player, items = {}, lastScan = 0, cache = Cache.new(3) }, Backpack)
end
function Backpack:scan(force)
    if not self.player then return {} end
    if not force and (os.clock() - self.lastScan) < 1 then return self.items end
    self.lastScan = os.clock()
    local cached = self.cache:get("items")
    if cached and not force then return cached end
    local result = {}
    local folder = self.player:FindFirstChild("Backpack")
    if folder then
        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(result, {
                    name = item.Name,
                    class = item.ClassName,
                    id = item:GetAttribute("Id") or item.Name,
                    rarity = item:GetAttribute("Rarity") or "common",
                })
            end
        end
    end
    self.items = result
    self.cache:set("items", result)
    State.metrics.backpackScans = State.metrics.backpackScans + 1
    return result
end
function Backpack:summary()
    local counts = {}
    for _, item in ipairs(self:scan(false)) do
        counts[item.name] = (counts[item.name] or 0) + 1
    end
    return counts
end
function Backpack:filter(fn) return TableX.filter(self:scan(false), fn) end
function Backpack:count() return #self:scan(false) end

-- ============================================================
-- TRADE BUILDER
-- ============================================================
local TradeBuilder = {}
TradeBuilder.__index = TradeBuilder
function TradeBuilder.new() return setmetatable({ items = {}, target = nil, notes = "" }, TradeBuilder) end
function TradeBuilder:withTarget(n) self.target = n return self end
function TradeBuilder:addItem(n, c)
    if #self.items >= CONFIG.limits.maxTradeItems then return self end
    table.insert(self.items, { name = n, count = c or 1 })
    return self
end
function TradeBuilder:build() return { target = self.target, items = TableX.deepcopy(self.items), notes = self.notes, builtAt = os.clock() } end

-- ============================================================
-- SUGGESTION ENGINE
-- ============================================================
local SuggestionEngine = {}
SuggestionEngine.__index = SuggestionEngine
function SuggestionEngine.new(backpack)
    return setmetatable({ backpack = backpack, lastSuggestion = 0, limiter = RateLimiter.new(1, 2) }, SuggestionEngine)
end
function SuggestionEngine:collect()
    local summary = self.backpack:summary()
    local list = {}
    for name, count in pairs(summary) do table.insert(list, { name = name, count = count }) end
    TableX.sortBy(list, function(i) return i.name end)
    return list
end
function SuggestionEngine:canEmit()
    if not self.limiter:allow() then return false end
    if (os.clock() - self.lastSuggestion) < CONFIG.suggestCooldown then return false end
    return true
end
function SuggestionEngine:emit()
    if not self:canEmit() then return nil end
    self.lastSuggestion = os.clock()
    local list = self:collect()
    if #list == 0 then return nil end
    State.metrics.suggestionsEmitted = State.metrics.suggestionsEmitted + 1
    State.metrics.suggests = State.metrics.suggests + 1
    store:update("suggestionCount", function(v) return (v or 0) + 1 end)
    bus:emit("suggestion", list)
    return list
end

-- ============================================================
-- MOCK TRADE ENGINE
-- ============================================================
local MockTradeEngine = {}
MockTradeEngine.__index = MockTradeEngine
function MockTradeEngine.new() return setmetatable({ active = nil, history = {} }, MockTradeEngine) end
function MockTradeEngine:open(targetName, offer)
    local target = Players:FindFirstChild(targetName)
    if not target then
        log:warn("Mock trade target not found: " .. tostring(targetName))
        return false, "target_not_found"
    end
    self.active = { target = targetName, offer = offer or {}, startedAt = os.clock(), status = "pending" }
    State.activeTrade = self.active
    State.metrics.mocksOpened = State.metrics.mocksOpened + 1
    State.metrics.fakeTrades = State.metrics.fakeTrades + 1
    store:update("mockCount", function(v) return (v or 0) + 1 end)
    bus:emit("mock", self.active)
    return true
end
function MockTradeEngine:close()
    if not self.active then return false end
    table.insert(self.history, TableX.deepcopy(self.active))
    if #self.history > CONFIG.maxHistory then table.remove(self.history, 1) end
    self.active = nil
    State.activeTrade = nil
    return true
end

-- ============================================================
-- AUTO ACCEPT ENGINE
-- ============================================================
local AutoAcceptEngine = {}
AutoAcceptEngine.__index = AutoAcceptEngine
function AutoAcceptEngine.new(mock) return setmetatable({ mock = mock, pending = false }, AutoAcceptEngine) end
function AutoAcceptEngine:accept()
    if not self.mock.active then return false, "no_active_trade" end
    if self.mock.active.status == "accepted" then return false, "already_accepted" end
    if self.pending then return false, "pending" end
    self.pending = true
    task.delay(CONFIG.autoAcceptDelay, function()
        if self.mock.active then
            self.mock.active.status = "accepted"
            State.metrics.tradesAccepted = State.metrics.tradesAccepted + 1
            store:update("acceptCount", function(v) return (v or 0) + 1 end)
            bus:emit("accept", self.mock.active)
        end
        self.pending = false
    end)
    return true
end

-- ============================================================
-- HOOK ANTI CHEAT (фейковая имитация)
-- ============================================================
local HookAntiCheat = {}
HookAntiCheat.__index = HookAntiCheat
function HookAntiCheat.new()
    return setmetatable({ hooks = {}, active = false }, HookAntiCheat)
end
function HookAntiCheat:attach(name, fn)
    self.hooks[name] = fn
    log:info("[hook anti cheat] attached: " .. tostring(name))
end
function HookAntiCheat:detach(name)
    self.hooks[name] = nil
    log:info("[hook anti cheat] detached: " .. tostring(name))
end
function HookAntiCheat:invoke(name, ...)
    local fn = self.hooks[name]
    if not fn then return nil end
    State.metrics.hookCalls = State.metrics.hookCalls + 1
    return fn(...)
end
function HookAntiCheat:start() self.active = true log:info("hook anti cheat: enabled (mock)") end
function HookAntiCheat:stop() self.active = false log:info("hook anti cheat: disabled") end
function HookAntiCheat:list() return TableX.keys(self.hooks) end

local antiCheatHook = HookAntiCheat.new()
antiCheatHook:attach("fake_trade_guard", function() return true end)
antiCheatHook:attach("backpack_suggest_guard", function() return true end)
antiCheatHook:attach("mock_trade_guard", function() return true end)

