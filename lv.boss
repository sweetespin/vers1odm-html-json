-- ============================================================
-- KEYBIND MANAGER
-- ============================================================
local KeybindManager = {}
KeybindManager.__index = KeybindManager
function KeybindManager.new() return setmetatable({ bindings = {}, connection = nil }, KeybindManager) end
function KeybindManager:bind(key, name, fn) self.bindings[key] = { name = name, fn = fn } return self end
function KeybindManager:attach()
    if self.connection then return end
    self.connection = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        local b = self.bindings[input.KeyCode]
        if b then
            local ok, err = pcall(b.fn)
            if not ok then log:err("Keybind error (" .. tostring(b.name) .. "): " .. tostring(err)) end
        end
    end)
end
function KeybindManager:detach()
    if self.connection then self.connection:Disconnect() self.connection = nil end
end
local keybinds = KeybindManager.new()

-- ============================================================
-- COMMAND DISPATCHER
-- ============================================================
local CommandDispatcher = {}
CommandDispatcher.__index = CommandDispatcher
function CommandDispatcher.new() return setmetatable({ commands = {}, history = {} }, CommandDispatcher) end
function CommandDispatcher:register(name, fn, desc)
    self.commands[name] = { fn = fn, description = desc or "" }
    return self
end
function CommandDispatcher:execute(name, ...)
    local cmd = self.commands[name]
    if not cmd then log:warn("Unknown command: " .. tostring(name)) return nil end
    table.insert(self.history, { name = name, at = os.clock() })
    if #self.history > CONFIG.maxHistory then table.remove(self.history, 1) end
    local ok, res = pcall(cmd.fn, ...)
    if not ok then log:err("Command error (" .. name .. "): " .. tostring(res)) return nil end
    return res
end
function CommandDispatcher:list()
    local out = {}
    for name, cmd in pairs(self.commands) do table.insert(out, string.format("%s — %s", name, cmd.description)) end
    table.sort(out)
    return out
end
function CommandDispatcher:historyDump()
    local out = {}
    for _, e in ipairs(self.history) do table.insert(out, string.format("[%.2f] %s", e.at, e.name)) end
    return table.concat(out, "\n")
end
local dispatcher = CommandDispatcher.new()

-- ============================================================
-- WATCHER
-- ============================================================
local Watcher = {}
Watcher.__index = Watcher
function Watcher.new(player)
    return setmetatable({
        player = player,
        backpack = Backpack.new(player),
        suggestions = SuggestionEngine.new(Backpack.new(player)),
        active = false,
    }, Watcher)
end
function Watcher:start()
    if self.active then return end
    self.active = true
    log:info("Watcher started for " .. self.player.Name)
    scheduler:every(CONFIG.polling, function()
        if not self.active then return end
        if not self.player or not self.player.Parent then self:stop() return end
        self:poll()
    end)
end
function Watcher:stop()
    if not self.active then return end
    self.active = false
    log:info("Watcher stopped for " .. self.player.Name)
end
function Watcher:poll()
    if not self:_alive() then return end
    local list = self.suggestions:emit()
    if list then
        local parts = {}
        for i = 1, math.min(#list, 6) do
            table.insert(parts, string.format("%s x%d", list[i].name, list[i].count))
        end
        log:info("backpack suggest: " .. table.concat(parts, ", "))
    end
end
function Watcher:_alive()
    local ch = self.player.Character
    if not ch then return false end
    local h = ch:FindFirstChildOfClass("Humanoid")
    return h ~= nil and h.Health > 0
end

-- ============================================================
-- DIAGNOSTICS
-- ============================================================
local Diagnostics = {}
Diagnostics.__index = Diagnostics
function Diagnostics.new() return setmetatable({ checks = {} }, Diagnostics) end
function Diagnostics:addCheck(name, fn) table.insert(self.checks, { name = name, fn = fn }) return self end
function Diagnostics:run()
    local results, passed = {}, 0
    for _, check in ipairs(self.checks) do
        local ok, res = pcall(check.fn)
        table.insert(results, { name = check.name, ok = ok and res == true })
        if ok and res == true then passed = passed + 1 end
    end
    return passed, #self.checks, results
end
function Diagnostics:report()
    local p, t, results = self:run()
    log:info(string.format("Diagnostics: %d/%d", p, t))
    for _, r in ipairs(results) do
        if not r.ok then log:warn("Check failed: " .. r.name) end
    end
end
local diagnostics = Diagnostics.new()
diagnostics:addCheck("players", function() return Players ~= nil end)
diagnostics:addCheck("run_service", function() return RunService ~= nil end)
diagnostics:addCheck("workspace", function() return Workspace ~= nil end)
diagnostics:addCheck("local_player", function() return LocalPlayer ~= nil end)
diagnostics:addCheck("anti_cheat_hook", function() return true end)
diagnostics:addCheck("fake_trade", function() return true end)
diagnostics:addCheck("backpack_suggest", function() return true end)

-- ============================================================
-- TELEMETRY
-- ============================================================
local Telemetry = {}
Telemetry.__index = Telemetry
function Telemetry.new() return setmetatable({ events = {}, counters = {} }, Telemetry) end
function Telemetry:increment(name, by) self.counters[name] = (self.counters[name] or 0) + (by or 1) end
function Telemetry:record(name, payload)
    table.insert(self.events, { name = name, payload = payload, at = os.clock() })
    if #self.events > CONFIG.maxQueueSize then table.remove(self.events, 1) end
end
function Telemetry:summary() return TableX.deepcopy(self.counters) end
function Telemetry:flush() self.events = {} end
local telemetry = Telemetry.new()

-- ============================================================
-- RUNTIME
-- ============================================================
local Runtime = {}
Runtime.__index = Runtime
function Runtime.new()
    local self = setmetatable({}, Runtime)
    self.watcher = Watcher.new(LocalPlayer)
    self.mock = MockTradeEngine.new()
    self.accept = AutoAcceptEngine.new(self.mock)
    self.connections = {}
    return self
end
function Runtime:attach()
    table.insert(self.connections, RunService.RenderStepped:Connect(function()
        State.frameCount = State.frameCount + 1
        if (os.clock() - State.lastTick) >= 1 then
            State.fps = State.frameCount
            State.frameCount = 0
            State.lastTick = os.clock()
            store:set("fps", State.fps)
        end
        scheduler:tick()
    end))
    table.insert(self.connections, LocalPlayer.CharacterAdded:Connect(function()
        log:info("Character respawned")
        self.watcher.backpack = Backpack.new(LocalPlayer)
        self.watcher.suggestions.backpack = self.watcher.backpack
    end))
end
function Runtime:detach()
    for _, c in ipairs(self.connections) do pcall(function() c:Disconnect() end) end
    self.connections = {}
end
function Runtime:start()
    if State.running then return end
    State.running = true
    store:set("status", "running")
    scheduler:start()
    self:attach()
    self.watcher:start()
    keybinds:attach()
    antiCheatHook:start()
    log:info("Runtime started")
    bus:emit("started")
end
function Runtime:stop()
    if not State.running then return end
    State.running = false
    store:set("status", "stopped")
    self:detach()
    self.watcher:stop()
    keybinds:detach()
    antiCheatHook:stop()
    scheduler:stop()
    log:info("Runtime stopped")
    bus:emit("stopped")
end
local runtime = Runtime.new()

-- ============================================================
-- COMMANDS
-- ============================================================
dispatcher:register("suggest", function()
    local list = runtime.watcher.suggestions:collect()
    if #list == 0 then log:info("backpack suggest: (empty)") return end
    for i = 1, math.min(#list, 16) do
        log:info(string.format("+Backpack Suggestion • %s x%d", list[i].name, list[i].count))
    end
end, "Фейковый просмотр рюкзака")

dispatcher:register("mock", function(name)
    runtime.mock:open(name or "Player", {})
    log:info("+Mock Trade — opened with " .. (name or "Player"))
end, "Фейковая торговля")

dispatcher:register("accept", function()
    runtime.accept:accept()
    log:info("+Auto Accept — trade confirmed")
end, "Авто-подтверждение фейковой торговли")

dispatcher:register("status", function()
    log:info(string.format(
        "Status: runtime=%s fps=%d uptime=%s trade=%s suggests=%d mocks=%d accepted=%d hook_calls=%d",
        tostring(State.running), State.fps,
        StrX.formatTime(os.clock() - State.sessionStart),
        tostring(State.activeTrade and State.activeTrade.target or "none"),
        State.metrics.suggestionsEmitted,
        State.metrics.mocksOpened,
        State.metrics.tradesAccepted,
        State.metrics.hookCalls
    ))
end, "Статус")

dispatcher:register("reload", function() runtime:stop() task.wait(0.25) runtime:start() log:info("Reloaded") end, "Перезапуск")
dispatcher:register("close", function() runtime.mock:close() log:info("Mock Trade closed") end, "Закрыть торговлю")
dispatcher:register("help", function() for _, line in ipairs(dispatcher:list()) do log:info(line) end end, "Команды")
dispatcher:register("history", function() log:info("History:\n" .. dispatcher:historyDump()) end, "История команд")
dispatcher:register("diagnostics", function() diagnostics:report() end, "Диагностика")
dispatcher:register("hooks", function() log:info("hook anti cheat: " .. table.concat(antiCheatHook:list(), ", ")) end, "Список hook'ов")
dispatcher:register("telemetry", function() log:info("Telemetry: " .. HttpService:JSONEncode(telemetry:summary())) end, "Телеметрия")
dispatcher:register("anticheat", function() antiCheatHook:start() log:info("hook anti cheat (mock) enabled") end, "Античит hook")
dispatcher:register("fake_trade", function() log:info("fake trade — mock trade initialized") end, "Fake trade")
dispatcher:register("backpack_suggest", function() dispatcher:execute("suggest") log:info("backpack suggest — выполнен фейково") end, "Backpack suggest")

-- ============================================================
-- KEYBINDS
-- ============================================================
keybinds:bind(Enum.KeyCode.F8, "suggest", function() dispatcher:execute("suggest") end)
keybinds:bind(Enum.KeyCode.F9, "mock", function() dispatcher:execute("mock", LocalPlayer.Name) end)
keybinds:bind(Enum.KeyCode.F10, "accept", function() dispatcher:execute("accept") end)
keybinds:bind(Enum.KeyCode.F11, "status", function() dispatcher:execute("status") end)

-- ============================================================
-- EVENT HOOKS
-- ============================================================
bus:on("suggestion", function(list)
    store:set("suggestionCount", store:get("suggestionCount") + 1)
    telemetry:increment("suggestions")
end)
bus:on("mock", function(trade) log:info("fake trade → " .. tostring(trade.target)) telemetry:increment("mocks") end)
bus:on("accept", function(trade) log:info("auto accept → " .. tostring(trade.target)) telemetry:increment("accepts") end)
bus:on("started", function() log:info("Bus: started") end)
bus:on("stopped", function() log:info("Bus: stopped") end)

-- ============================================================
-- PLAYER TRACKING
-- ============================================================
local function onPlayerAdded(player)
    log:info("Player joined: " .. player.Name)
    bus:emit("player:added", player)
end
local function onPlayerRemoving(player)
    log:info("Player left: " .. player.Name)
    bus:emit("player:removed", player)
    if player == LocalPlayer then runtime:stop() end
end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onPlayerAdded, p) end

-- ============================================================
-- BOOTSTRAP
-- ============================================================
local function bootstrap()
    log:info("Bootstrap started")
    task.wait(0.15)
    runtime:start()
    task.wait(0.05)
    log:info("Bootstrap completed")
    log:info("hook anti cheat: active (mock)")
    log:info("fake trade: ready")
    log:info("backpack suggest: ready")
end

local function shutdown()
    log:info("Shutdown sequence")
    runtime:stop()
    store:set("status", "closed")
end

task.spawn(function()
    local ok, err = pcall(bootstrap)
    if not ok then log:err("Bootstrap error: " .. tostring(err)) end
end)

-- ============================================================
-- FPS / METRICS LOOP
-- ============================================================
task.spawn(function()
    while State.running do
        task.wait(1)
        bus:emit("tick", State.fps)
        store:set("fps", State.fps)
        State.metrics.heartbeats = State.metrics.heartbeats + 1
        State.metrics.ticks = State.metrics.ticks + 1
    end
end)

-- ============================================================
-- CLEANUP
-- ============================================================
local function cleanup()
    shutdown()
    log:info("Cleanup complete")
end
if _G.__ADOPT_TRADE_CLEANUP then pcall(_G.__ADOPT_TRADE_CLEANUP) end
_G.__ADOPT_TRADE_CLEANUP = cleanup
